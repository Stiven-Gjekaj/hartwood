# The options that hartwood needs on top of tinyconfig. The build script
# checks that each one is still set after olddefconfig.

# The machine.
CONFIG_64BIT=y
CONFIG_MMU=y
# CONFIG_SMP is not set
CONFIG_NONPORTABLE=y
CONFIG_FPU=y
CONFIG_RISCV_SBI=y
CONFIG_RISCV_TIMER=y
CONFIG_SIFIVE_PLIC=y
CONFIG_PRINTK=y
CONFIG_BUG=y

# The console on the 16550 UART.
CONFIG_TTY=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_EARLYCON=y

# The initramfs, ELF programs and scripts.
CONFIG_BLK_DEV_INITRD=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_TMPFS=y
CONFIG_MULTIUSER=y
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y

# The virtio block device.
CONFIG_BLOCK=y
CONFIG_VIRTIO_MENU=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y

# poweroff and reboot through the test device.
CONFIG_POWER_RESET=y
CONFIG_POWER_RESET_SYSCON=y
CONFIG_POWER_RESET_SYSCON_POWEROFF=y
